# Required for document embeddings
GEMINI_API_KEY=

# Required for Qdrant vector search
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=

# Required for the NeMo Guardrails LLM
GROQ_API_KEY=

# Optional; currently reserved for a separate fallback key
GROQ_FALLBACK_API_KEY=

# Required for Portkey-backed RAG generation
PORTKEY_API_KEY=
GROQ_SLUG=
GROQ_SLUG_2=

# Optional Logfire observability
LOGFIRE_TOKEN=

# Optional; defaults to http://localhost:8000 for the Streamlit UI
BACKEND_URL=
